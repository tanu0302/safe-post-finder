# Copy to .env and edit
PORT=5000
MONGODB_URI=mongodb+srv://<DB_USER>:<ENCODED_PASSWORD>@<CLUSTER_HOST>/safe_post_finder?retryWrites=true&w=majority
JWT_SECRET=replace_with_strong_secret
DETECTION_PROVIDER=local   # or  'google'
UPLOAD_DIR=uploads
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
